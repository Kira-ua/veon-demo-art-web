---
import Base from "../layouts/Base.astro";
---
<Base lang="uk" title="Сторінку не знайдено — Арт-Веб" description="Такої сторінки немає. Поверніться на головну сторінку студії Арт-Веб.">
  <section class="nf container">
    <h1>Сторінку не знайдено</h1>
    <p>Можливо, адреса змінилася або розділ ще в розробці.</p>
    <a class="btn" href={import.meta.env.BASE_URL}>На головну</a>
  </section>
</Base>
<style>
  .nf { min-height: 80svh; display: grid; align-content: center; justify-items: start; gap: var(--s-5); padding-block: var(--s-8); }
  .nf h1 { font-size: var(--fs-h2); text-wrap: balance; }
</style>
