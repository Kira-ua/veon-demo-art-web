---
import TelegramIcon from "./TelegramIcon.astro";
import { contacts } from "../data/content";
---
<section id="contact" class="contact" aria-labelledby="contact-title" data-rec="R-001,R-005,G-R002,M-R004">
  <div class="container contact__grid">
    <h2 id="contact-title" class="contact__title">Напишіть, що потрібно зробити</h2>

    <div class="contact__channels">
      <a class="contact__tg" href={contacts.telegram} target="_blank" rel="noopener">
        <TelegramIcon class="contact__tg-icon" />
        <span>Написати в Telegram</span>
      </a>
      <p class="contact__mail"><span class="contact__label">або на e-mail</span> <a href={contacts.emailHref}>{contacts.email}</a></p>
    </div>

    <div class="contact__notes">
      <div>
        <h3 class="contact__h3">Що написати в першому повідомленні</h3>
        <p>Який сайт потрібен, приклади сайтів, які вам подобаються, і бажані терміни.</p>
      </div>
      <div>
        <h3 class="contact__h3">Офіс</h3>
        <p><a class="contact__map" href={contacts.mapHref} target="_blank" rel="noopener">{contacts.address}</a></p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    --rise: 48px;
    --color-focus: var(--color-bg);
    margin-top: var(--section-gap);
    padding-block: calc(var(--rise) + var(--s-7)) var(--s-8);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    clip-path: polygon(0 var(--rise), 72% 0, 100% calc(var(--rise) * 0.6), 100% 100%, 0 100%);
  }
  .contact__grid { display: grid; gap: var(--s-6); }
  .contact__title { font-size: var(--fs-h2); max-width: 14ch; }
  .contact__channels { display: grid; gap: var(--s-5); justify-items: start; }
  .contact__tg {
    display: inline-flex; align-items: center; gap: var(--s-3); width: 100%; justify-content: center;
    min-height: 64px; padding: 0 var(--s-6); border-radius: var(--radius);
    background: var(--color-bg); color: var(--color-text);
    font: 800 1.25rem/1.1 var(--font-display); font-variation-settings: var(--shrp); text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .contact__tg:hover { background: var(--color-text); color: var(--color-bg); }
  .contact__tg:active { transform: scale(.98); }
  .contact :global(.contact__tg-icon) { width: 24px; height: 24px; transition: transform var(--dur-fast) var(--ease-out); }
  .contact__tg:hover :global(.contact__tg-icon) { transform: translate(2px, -2px); }
  .contact__mail { display: grid; gap: var(--s-1); }
  .contact__label { font-size: var(--fs-small); font-weight: 600; }
  .contact__mail a { font: 800 clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem)/1.15 var(--font-display); font-variation-settings: var(--shrp); letter-spacing: -0.01em; overflow-wrap: anywhere; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  .contact__mail a:hover { text-decoration-thickness: 4px; }
  .contact__notes { display: grid; gap: var(--s-5); max-width: 44rem; }
  .contact__h3 { font: 600 var(--fs-body)/1.3 var(--font-body); letter-spacing: 0; margin-bottom: var(--s-1); }

  @media (min-width: 600px) {
    .contact__tg { width: auto; }
  }
  @media (min-width: 1024px) {
    .contact { --rise: 96px; padding-block: calc(var(--rise) + var(--s-8)) var(--s-9); }
    .contact__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); row-gap: var(--s-7); }
    .contact__title { grid-column: 1 / span 7; }
    .contact__channels { grid-column: 1 / span 7; }
    .contact__notes { grid-column: 9 / -1; grid-row: 1 / span 2; align-self: end; }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact__tg:active, .contact__tg:hover :global(.contact__tg-icon) { transform: none; }
  }
</style>
