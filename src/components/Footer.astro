---
import Monogram from "./Monogram.astro";
import FutureLink from "./FutureLink.astro";
import { nav, contacts, FUTURE } from "../data/content";

const future = ["Створення сайтів", "Просування сайтів", "Реклама в інтернеті", "Підтримка сайтів", "Дизайн", "Усі ціни і калькулятор", "Портфоліо", "Корисні статті"];
---
<footer id="footer" class="footer" data-rec="R-009,S-R001">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a class="footer__logo" href="#top" aria-label="Арт-Веб, на початок сторінки">
        <Monogram size={40} />
        <span class="footer__name">Арт-Веб</span>
      </a>
      <p class="footer__muted">Створення сайтів у Львові з 2008 року</p>
    </div>

    <div class="footer__col">
      <p class="footer__title">Зв’язок</p>
      <ul class="footer__list">
        <li><a href={contacts.telegram} target="_blank" rel="noopener">Telegram {contacts.telegramLabel}</a></li>
        <li><a href={contacts.emailHref}>{contacts.email}</a></li>
        <li><a href={contacts.mapHref} target="_blank" rel="noopener">{contacts.address}</a></li>
      </ul>
    </div>

    <nav class="footer__col" aria-label="Розділи головної">
      <p class="footer__title">На цій сторінці</p>
      <ul class="footer__list">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer__col">
      <p class="footer__title">Скоро на сайті</p>
      <ul class="footer__list">
        {future.map((f) => <li><FutureLink note={FUTURE}>{f}</FutureLink></li>)}
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <p class="footer__muted">© Арт-Веб</p>
    <FutureLink note={FUTURE}>Політика конфіденційності</FutureLink>
    <p class="footer__passport" data-passport data-rec="R-210" aria-live="off"></p>
  </div>
</footer>

<script>
  // «Паспорт сторінки»: only values measured in this visitor's browser (Performance API). No API, no line.
  const out = document.querySelector<HTMLElement>("[data-passport]");
  const fmt = (n: number, d: number) => n.toLocaleString("uk-UA", { minimumFractionDigits: d, maximumFractionDigits: d });
  const measure = () => {
    if (!out || !("performance" in window) || !performance.getEntriesByType) return;
    const nav = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
    if (!nav || !nav.loadEventEnd) return;
    const res = performance.getEntriesByType("resource") as PerformanceResourceTiming[];
    const bytes = [nav, ...res].reduce((sum, e) => sum + (e.encodedBodySize || 0), 0);
    if (!bytes) return;
    const kb = bytes / 1024;
    const size = kb >= 1024 ? `${fmt(kb / 1024, 1)} МБ` : `${fmt(kb, 0)} КБ`;
    const secs = nav.loadEventEnd / 1000;
    const sec = fmt(secs, secs < 1 ? 2 : 1);
    out.textContent = `Ця сторінка у вашому браузері: ${size}, завантажилась за ${sec} с.`;
    out.classList.add("is-ready");
  };
  if (document.readyState === "complete") setTimeout(measure, 0);
  else addEventListener("load", () => setTimeout(measure, 0), { once: true });
</script>

<style>
  .footer { background: var(--color-surface); padding-block: var(--s-8) var(--s-6); }
  .footer__grid { display: grid; gap: var(--s-6) var(--col-gap); grid-template-columns: minmax(0, 1fr); }
  .footer__brand { display: grid; gap: var(--s-3); align-content: start; }
  .footer__logo { display: inline-flex; align-items: center; gap: var(--s-3); min-height: 44px; text-decoration: none; justify-self: start; border-radius: var(--radius); }
  .footer__name { font: 800 1.5rem/1 var(--font-display); font-variation-settings: var(--shrp); letter-spacing: -0.02em; }
  .footer__title { font-weight: 600; margin-bottom: var(--s-3); }
  .footer__list { display: grid; gap: var(--s-1); }
  .footer__list a, .footer__list :global(.future-link) { display: inline-flex; align-items: center; min-height: 36px; }
  .footer__list a { text-decoration: none; }
  .footer__list a:hover { text-decoration: underline; }
  .footer__muted { color: var(--color-muted); }
  .footer__bottom { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-6); margin-top: var(--s-7); padding-top: var(--s-5); border-top: 1px solid var(--color-line); font-size: var(--fs-small); }
  .footer__passport { min-height: 1.55em; color: var(--color-muted); visibility: hidden; }
  .footer__passport:global(.is-ready) { visibility: visible; }

  @media (min-width: 600px) {
    .footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .footer__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .footer__brand { grid-column: 1 / span 4; }
    .footer__grid > :nth-child(2) { grid-column: 5 / span 3; }
    .footer__grid > :nth-child(3) { grid-column: 8 / span 2; }
    .footer__grid > :nth-child(4) { grid-column: 10 / span 3; }
    .footer__passport { margin-left: auto; }
  }
</style>
