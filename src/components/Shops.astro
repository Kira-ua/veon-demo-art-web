---
import TelegramIcon from "./TelegramIcon.astro";
import { shopItems, contacts, nb } from "../data/content";
---
<section id="shops" class="section shops" aria-labelledby="shops-title" data-rec="R-015">
  <div class="container shops__grid">
    <div class="shops__head">
      <h2 id="shops-title">Для інтернет-магазинів</h2>
      <p class="section__intro">1С, оплата, доставка, товари. Напишіть, на якій CMS працює ваш магазин і що потрібно підключити.</p>
      <a class="btn shops__btn" href={contacts.telegram} target="_blank" rel="noopener">
        <TelegramIcon />
        <span>Обговорити в Telegram</span>
      </a>
    </div>

    <ul class="shops__list">
      {shopItems.map((it) => (
        <li class="shops__item">
          <span class="shops__price num">{nb(it.price)}</span>
          <span class="shops__name">{it.name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .shops__grid { display: grid; gap: var(--s-7); }
  .shops__head { display: grid; gap: var(--s-4); align-content: start; justify-items: start; }
  .shops__btn { margin-top: var(--s-2); }
  .shops__list { display: grid; gap: var(--s-6) var(--col-gap); grid-template-columns: minmax(0, 1fr); }
  .shops__item { display: grid; gap: var(--s-1); }
  .shops__price { font: 800 1.25rem/1.1 var(--font-display); font-variation-settings: var(--shrp); letter-spacing: -0.01em; color: var(--color-accent); }
  .shops__name { font-size: var(--fs-body); }

  @media (min-width: 360px) {
    .shops__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .shops__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); }
    .shops__head { grid-column: 1 / span 5; position: sticky; top: calc(var(--header-h) + var(--s-6)); }
    .shops__list { grid-column: 7 / -1; row-gap: var(--s-7); }
    .shops__price { font-size: 2rem; }
  }
  @media (min-width: 600px) and (max-width: 1023px) {
    .shops__price { font-size: 1.5rem; }
  }
</style>
