---
import TelegramIcon from "./TelegramIcon.astro";
import { contacts } from "../data/content";
---
<section id="top" class="hero" aria-labelledby="hero-title" data-rec="R-003,R-014,R-016,R-201,G-R003,G-R004,M-R007,R-113">
  <div class="hero__mark" aria-hidden="true">
    <svg class="hero__triangle" viewBox="0 0 1155 1000" preserveAspectRatio="none" width="1155" height="1000" focusable="false"><path d="M0 1000 577.5 0 1155 1000z" fill="var(--color-brand)" /></svg>
  </div>
  <div class="hero__wedge" aria-hidden="true"></div>

  <div class="hero__inner container">
    <div class="hero__main">
      <h1 id="hero-title" class="hero__title" data-rec="R-102"><span class="hero__line">Створення</span> <span class="hero__line">сайтів</span> <span class="hero__line hero__line--3">у Львові</span></h1>
      <p class="hero__lead">Розробка, просування, контекстна реклама, підтримка і&nbsp;дизайн сайтів — одна команда з&nbsp;2008&nbsp;року.</p>
      <div class="hero__actions" data-rec="R-001">
        <a class="btn hero__btn" href={contacts.telegram} target="_blank" rel="noopener">
          <TelegramIcon />
          <span>Написати в Telegram</span>
        </a>
        <p class="hero__mail"><span class="hero__mail-or">або на e-mail:</span> <a class="link-strong" href={contacts.emailHref}>{contacts.email}</a></p>
      </div>
      <p class="hero__price" data-rec="R-015"><span class="hero__price-note">Сайт-візитка або лендінг</span> <span class="hero__price-sum num">від&nbsp;7&nbsp;500&nbsp;грн</span></p>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; overflow: clip; padding-top: var(--header-h); }
  .hero__inner { position: relative; z-index: 1; display: grid; gap: var(--s-5); padding-block: var(--s-6) calc(72px + var(--s-5)); }
    .hero__main { display: grid; gap: var(--s-5); }
  .hero__title { font-size: var(--fs-h1); line-height: 1; letter-spacing: -0.03em; text-wrap: initial; }
  .hero__line { display: block; white-space: nowrap; }
  .hero__lead { order: 1; font-size: var(--fs-lead); line-height: 1.45; max-width: 34rem; }
  .hero__price { order: 2; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--s-3); }
  .hero__price-note { color: var(--color-muted); font-weight: 600; font-size: 0.9375rem; }
  .hero__price-sum { font: 800 1.5rem/1.1 var(--font-display); font-variation-settings: var(--shrp); color: var(--color-accent); letter-spacing: -0.01em; }
  .hero__actions { order: 3; display: grid; gap: var(--s-4); }
  .hero__btn { width: 100%; }
  .hero__mail { color: var(--color-muted); overflow-wrap: anywhere; }
  .hero__mail .link-strong { font-size: 1.0625rem; }

  /* Phone and tablet: the triangle becomes a red wedge at the fold, the price is a line of text. */
  .hero__mark { display: none; }
  .hero__wedge { position: absolute; inset: auto 0 0 0; height: 72px; background: var(--color-brand); clip-path: polygon(0 100%, 100% 0, 100% 100%); animation: hero-fade 300ms var(--ease-out) both; }

  @media (min-width: 600px) {
    .hero__btn { width: auto; justify-self: start; }
    .hero__wedge { height: 140px; }
    .hero__inner { padding-bottom: calc(140px + var(--s-5)); }
  }

  /* Desktop: the triangle of the «A» grows from the bottom edge, cropped by the window, and carries the price. */
  @media (min-width: 1024px) {
    .hero { min-height: max(640px, 100svh); display: flex; flex-direction: column; }
    .hero__wedge { display: none; }
    .hero__inner { flex: 1; align-content: end; padding-block: var(--s-6) var(--s-7); }
    .hero__main { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--col-gap); row-gap: var(--s-5); }
    .hero__title { grid-column: 1 / -1; line-height: 0.95; }
    .hero__line--3 { padding-left: 36%; }
    .hero__lead { grid-column: 1; max-width: 36rem; }
    .hero__actions { grid-column: 1; grid-template-columns: auto; justify-items: start; }
    .hero__price { position: absolute; right: 0; bottom: var(--s-6); display: grid; justify-items: end; text-align: right; gap: var(--s-2); color: var(--color-text); }
    .hero__price-note { color: var(--color-text); font-size: clamp(1.125rem, 0.6rem + 0.8vw, 1.5rem); }
    .hero__price-sum { color: var(--color-text); font-size: clamp(2.5rem, 0.8rem + 3.4vw, 4rem); letter-spacing: -0.02em; }

    .hero__mark { display: block; position: absolute; z-index: 0; bottom: 0; left: 47%; height: 80%; aspect-ratio: 1155 / 1000; animation: hero-grow var(--dur-grow) var(--ease-out) both; }
    .hero__triangle { width: 100%; height: 100%; }
  }
  @media (min-width: 1440px) {
    .hero__mark { left: 46%; height: 82%; }
  }

  @keyframes hero-grow { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes hero-fade { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .hero__mark, .hero__wedge { animation: none; }
  }
</style>
